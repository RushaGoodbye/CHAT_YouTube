RG_REMOTE_HOST=0.0.0.0
RG_REMOTE_PORT=8765
RG_REMOTE_ROOTS=/data/youtube=/mnt/youtube;/data/auto_edit=/mnt/auto_edit
RG_REMOTE_MAX_READ_BYTES=1048576
RG_REMOTE_MAX_WRITE_BYTES=1048576
RG_REMOTE_ALLOWED_COMMANDS=python,python3,powershell,pwsh,git,docker,docker-compose,ls,cat,find,grep,du,df
RG_REMOTE_SSH_ALIASES=alexpc=alexpc:22
RG_REMOTE_SSH_WINDOWS_ALIASES=alexpc
RG_REMOTE_SSH_USER=rgremote
RG_REMOTE_SSH_KEY=/run/secrets/alexpc_ssh_key
RG_REMOTE_SSH_KNOWN_HOSTS=/run/secrets/known_hosts
