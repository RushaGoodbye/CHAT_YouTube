# RG NAS MCP Hub
RG_REMOTE_HOST=0.0.0.0
RG_REMOTE_PORT=8765
RG_REMOTE_MAX_READ_BYTES=1048576
RG_REMOTE_MAX_WRITE_BYTES=1048576

# Internal worker URLs. Normally do not change.
RG_WORKER_YOUTUBE_URL=http://youtube-worker:8780
RG_WORKER_TELEGRAM_URL=http://telegram-worker:8780
RG_WORKER_AUTO_EDIT_URL=http://auto-edit-worker:8780

# AlexPC bridge. Used only when SSH is enabled later.
RG_REMOTE_ALEXPC=alexpc:22
RG_REMOTE_SSH_WINDOWS_ALIASES=alexpc
RG_REMOTE_SSH_USER=rgremote
RG_REMOTE_SSH_KEY=/run/secrets/alexpc_ssh_key
RG_REMOTE_SSH_KNOWN_HOSTS=/run/secrets/known_hosts
